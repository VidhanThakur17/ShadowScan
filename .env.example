# ShadowScan environment variables (EXAMPLE — copy to .env and fill locally).
# NEVER commit real secrets. .env is git-ignored; .env.example is a template only.
#
# Secrets are referenced by NAME from program configuration (auth profiles,
# notifications, AI). ShadowScan reads the value from the environment at runtime
# and never stores it in SQLite, exports, logs or notifications.

# --- Authentication tokens (one per auth profile/context; names are your choice) ---
# Referenced from programs/<name>/auth.yaml via `env:` keys.
SHADOWSCAN_PROGRAM_X_VIEWER_TOKEN=
SHADOWSCAN_PROGRAM_X_ADMIN_TOKEN=

# --- AI provider (optional; the deterministic pipeline works without AI) ---
# SHADOWSCAN_AI_PROVIDER=mock        # mock | openai | anthropic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Notification webhook (optional) ---
# SHADOWSCAN_WEBHOOK_URL=
